{
  "appId": "com.schofy.desktop.lite",
  "productName": "Schofy Lite",
  "compression": "maximum",
  "asar": true,
  "electronLanguages": [
    "en-US"
  ],
  "directories": {
    "output": "../dist/desktop-lite"
  },
  "files": [
    "main.js",
    "preload.js",
    "workers.js",
    "installer.nsh",
    "package.json"
  ],
  "asarUnpack": [
    "workers.js"
  ],
  "extraResources": [
    {
      "from": "../client/dist",
      "to": "client-dist",
      "filter": [
        "**/*",
        "!**/*.map",
        "!**/node_modules/**"
      ]
    }
  ],
  "win": {
    "executableName": "Schofy Lite",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "../client/public/schofy.logo.ico",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Schofy Lite",
    "include": "installer.nsh"
  }
}
