{
  "name": "@schofy/desktop",
  "version": "1.0.8",
  "description": "Schofy desktop app",
  "author": "Schofy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.schofy.desktop",
    "productName": "Schofy",
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "installer.nsh",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../client/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Schofy",
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "30.0.3",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  }
}
