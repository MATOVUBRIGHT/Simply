{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!assets|favicon|icon|manifest|sw\\.js|sound|sounds|.*\\.(?:js|css|png|jpg|jpeg|webp|svg|ico|json|woff2?|ttf|wav|mp3)$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
